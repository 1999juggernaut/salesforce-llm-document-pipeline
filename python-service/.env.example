# LLM (Ollama running locally; any model you have pulled)
OLLAMA_URL=http://127.0.0.1:11434/api/generate
MODEL_NAME=llama3
LLM_TIMEOUT_S=300
# Context budget and limits
MAX_WORDS=4000
MAX_FILE_BYTES=6000000
# Reliability
RETRY_ATTEMPTS=3
RETRY_BASE_DELAY_S=2
JOB_TTL_S=3600
# Salesforce auth for the callback: set a token, or the alias of an `sf` CLI org for local dev
SF_ACCESS_TOKEN=
SF_TARGET_ORG=my-dev-org
